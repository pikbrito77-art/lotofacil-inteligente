{
  "expo": {
    "name": "Lotofácil Inteligente",
    "slug": "lotofacil-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lotofacil.inteligente",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "Receba alertas de resultados e dicas semanais",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E20"
      },
      "package": "com.lotofacil.inteligente",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "scheme": "lotofacil",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b6565b37-614d-4bf5-87f7-3f1a1b13b068"
      }
    },
    "owner": "krisbrito"
  }
}
